<!--
  FloServer's installer (D21): one per-user MSI, no admin rights.
  Built in CI with WiX 5 (pinned; WiX 6+ asks a maintenance fee of companies
  that earn money with it, D21):

    wix build installer\FloServer.wxs -ext WixToolset.UI.wixext -arch x64
        -d Version=<x.y.z> -d BinDir=<folder with the Release programs>
        -sice ICE38 -sice ICE64 -sice ICE91 -o FloServer-<x.y.z>-x64.msi

  What it does and doesn't touch is in D21 and in the EULA (section 6).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- The upgrade code never changes: it's how a newer MSI finds the old one. -->
  <Package Name="FloServer"
           Manufacturer="HostKurd"
           Version="$(Version)"
           UpgradeCode="3AC2E747-DDE1-465C-87CC-277C97C81D0F"
           Scope="perUser"
           Compressed="yes"
           InstallerVersion="500">

    <MajorUpgrade DowngradeErrorMessage="A newer version of FloServer is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="FloServer.ico" SourceFile="$(sys.SOURCEFILEDIR)..\src\ui-win32\FloServer.ico" />
    <Property Id="ARPPRODUCTICON" Value="FloServer.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://floserver.org" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- %LOCALAPPDATA%\Programs\FloServer, named outright: per user, never
         Program Files, so no admin rights (D5). Files in the user's profile
         make Windows Installer's ICE38/ICE64/ICE91 checks complain about
         machine-wide habits that don't apply here; the build skips those. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="PROGRAMSFOLDER" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="FloServer">
          <Directory Id="VCRUNTIMEFOLDER" Name="vcruntime" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- Every program finds the others next to itself, so they stay in one folder. -->
    <ComponentGroup Id="Programs" Directory="INSTALLFOLDER">
      <Component><File Source="$(BinDir)\FloServer.exe" /></Component>
      <Component><File Source="$(BinDir)\floserverd.exe" /></Component>
      <Component><File Source="$(BinDir)\floserver.exe" /></Component>
      <Component><File Source="$(BinDir)\flo.exe" /></Component>
      <Component><File Source="$(BinDir)\floserver-shim.exe" /></Component>
      <!-- The Visual C++ runtime next to the programs, so they start on a PC
           without the redistributable (app-local, which Microsoft allows). -->
      <Files Include="$(BinDir)\vcruntime\*.dll" />
      <!-- The folder on the user's Path, so flo works in new terminals. -->
      <Component Id="PathEntry" Guid="9D1E2B5C-6F0A-4C1E-9B2D-5A7E3C4F8B10">
        <Environment Id="FloOnPath" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="no" Permanent="no" />
        <RegistryValue Root="HKCU" Key="Software\HostKurd\FloServer" Name="PathEntry" Type="integer" Value="1" KeyPath="yes" />
        <!-- The folders go on uninstall (only when empty, which they are then). -->
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveVcRuntimeFolder" Directory="VCRUNTIMEFOLDER" On="uninstall" />
      </Component>
    </ComponentGroup>

    <!-- The copies the service hands to each runtime it installs (PHP, nginx, Apache). -->
    <ComponentGroup Id="VcRuntime" Directory="VCRUNTIMEFOLDER">
      <Files Include="$(BinDir)\vcruntime\*.dll" />
    </ComponentGroup>

    <ComponentGroup Id="StartMenu" Directory="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="2F6B8C1D-3E4A-4B5C-8D9E-0A1B2C3D4E5F">
        <Shortcut Id="FloServerShortcut" Name="FloServer" Target="[INSTALLFOLDER]FloServer.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="FloServer.ico" />
        <RegistryValue Root="HKCU" Key="Software\HostKurd\FloServer" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="FloServer" Level="1">
      <ComponentGroupRef Id="Programs" />
      <ComponentGroupRef Id="VcRuntime" />
      <ComponentGroupRef Id="StartMenu" />
    </Feature>

    <!-- Before files are replaced or removed: stop the service and everything
         it runs, so MariaDB shuts down cleanly. The window closes through
         Windows' Restart Manager. Uses the flo already installed. -->
    <CustomAction Id="StopFloServer" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]flo.exe&quot; stop" Execute="immediate" Return="ignore" />

    <!-- Uninstall only (not an upgrade): undo what the app added outside its folder. -->
    <CustomAction Id="RemoveShims" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]flo.exe&quot; shims remove" Execute="immediate" Return="ignore" />
    <CustomAction Id="RemoveCertificate" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]flo.exe&quot; untrust" Execute="immediate" Return="ignore" />
    <CustomAction Id="RemoveRunEntry" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[SystemFolder]reg.exe&quot; delete &quot;HKCU\Software\Microsoft\Windows\CurrentVersion\Run&quot; /v FloServer /f"
                  Execute="immediate" Return="ignore" />
    <CustomAction Id="RemoveRunApproval" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[SystemFolder]reg.exe&quot; delete &quot;HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\StartupApproved\Run&quot; /v FloServer /f"
                  Execute="immediate" Return="ignore" />

    <!-- flo untrust asks the service, starting it when it isn't running: stop
         it again afterwards, so its program can be removed. -->
    <CustomAction Id="StopFloServerAgain" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]flo.exe&quot; stop" Execute="immediate" Return="ignore" />

    <!-- InstallValidate (which checks for files in use) comes between
         CostFinalize and InstallInitialize. -->
    <InstallExecuteSequence>
      <Custom Action="StopFloServer" After="CostFinalize" Condition="Installed OR WIX_UPGRADE_DETECTED" />
      <Custom Action="RemoveCertificate" Before="InstallInitialize" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="StopFloServerAgain" After="RemoveCertificate" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RemoveShims" After="StopFloServerAgain" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RemoveRunEntry" After="RemoveShims" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RemoveRunApproval" After="RemoveRunEntry" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <!-- Two screens (D21 mockups): the licence with Install, then Done with "Open FloServer". -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)License.rtf" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open FloServer" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="OpenFloServer" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]FloServer.exe&quot;" Execute="immediate" Return="asyncNoWait" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="OpenFloServer"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
  </Package>
</Wix>
