// FloServer-Setup.exe's resources (configured by CMake): its icon and
// manifest, floserver-setup.dll, and FloServer's MSI when one was given.
#include <windows.h>

1 ICON "@FLOSERVER_SETUP_ICON@"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@FLOSERVER_SETUP_MANIFEST@"
FLOSERVER_SETUP_DLL RCDATA "$<TARGET_FILE:floserver_setup_dll>"
@_msi_line@

VS_VERSION_INFO VERSIONINFO
FILEVERSION @FLOSERVER_SETUP_VERSION_COMMAS@
PRODUCTVERSION @FLOSERVER_SETUP_VERSION_COMMAS@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "HostKurd"
            VALUE "FileDescription", "FloServer Setup"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "LegalCopyright", "HostKurd"
            VALUE "OriginalFilename", "FloServer-Setup.exe"
            VALUE "ProductName", "FloServer"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
