#include <windows.h>

// The lowest-numbered icon is the one Explorer, the Start menu and shortcuts
// show for FloServer.exe; the window, Settings and the tray load it too
// (make_app_icon in canvas.cpp). Made from icons/FloServer.svg by
// tools/icon/make_app_icon.js.
1 ICON "FloServer.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "FloServer.manifest"
